{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-validator": "^0.7.6",
    "@pm/db": "workspace:*",
    "@pm/env": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@pm/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
